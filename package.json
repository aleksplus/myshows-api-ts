{
  "name": "@p.aleks/myshows-api",
  "version": "0.0.29",
  "description": "A simple API for logging into and interacting with MyShows website. Rewritten to Typescript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist/*",
    "prepublishOnly": "yarn clean && yarn build",
    "format": "yarn run biome format --write src/",
    "lint": "yarn run biome lint --write src/",
    "check": "yarn run biome check --write src/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Aleks P. (https://github.com/aleksplus)",
  "contributors": [
    "Sergey Vytrishko (https://github.com/asznee7)"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "0.27.2"
  },
  "devDependencies": {},
  "optionalDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/node": "^18.14.1",
    "json-rpc-2.0": "^1.5.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.9.5"
  }
}
