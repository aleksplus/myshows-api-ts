{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    /* JS and .d.ts emit is done by tsdown (oxc); tsc is a pure typecheck. */
    "noEmit": true,
    /* Required alongside isolatedDeclarations; noEmit keeps tsc from writing anything. */
    "declaration": true,
    "strict": true,
    "isolatedDeclarations": true,
    "esModuleInterop": true,
    /* Advanced Options */
    "skipLibCheck": true,
    /* Skip type checking of declaration files. */
    "forceConsistentCasingInFileNames": true
    /* Disallow inconsistently-cased references to the same file. */
  },
  "exclude": [
    "node_modules",
    "dist",
    "example",
    "test",
    "tsdown.config.mts"
  ]
}